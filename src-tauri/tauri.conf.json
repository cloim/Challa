{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Challa",
  "version": "0.2.1",
  "identifier": "com.challa.app",
  "build": {
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Challa",
        "visible": false,
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "theme": "Dark",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cloim/Challa/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxQTA1NkMzRjM5RUQyQzYKUldURzBwN3p3MWFna2RvYVNXVXJBcVh6S2hDZ0F5K1EwUzYybGo4K042ck5PMUJ0SmpHSGRiZ1MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
