{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Challa",
  "version": "0.1.0",
  "identifier": "com.challa.app",
  "build": {
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Challa",
        "visible": false,
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "theme": "Dark",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
